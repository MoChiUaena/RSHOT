{
  "name": "aihot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "npm run dev -w @aihot/api",
    "dev:worker": "npm run dev -w @aihot/worker",
    "dev:web": "npm run dev -w @aihot/web",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && tsc -p scripts && npm run typecheck -w @aihot/web",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/*.test.ts\"",
    "check:secrets": "node scripts/check-secrets.ts --tracked",
    "setup:hooks": "node scripts/install-hooks.ts",
    "model:prepare": "node scripts/prepare-model.ts",
    "model:check": "node scripts/probe-model.ts",
    "review:prepare": "node --env-file=.env scripts/prepare-review.ts",
    "review:export": "node --env-file=.env scripts/export-labels.ts",
    "updates:check": "node scripts/start-updates.ts",
    "updates:status": "node --env-file=.env scripts/updates-status.ts",
    "updates:stop": "node --env-file=.env scripts/stop-updates.ts",
    "preview:export": "node scripts/export-preview.ts",
    "preview:build": "node scripts/build-preview.ts",
    "preview:serve": "node scripts/serve-preview.ts",
    "preview:publish": "node scripts/publish-preview.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  }
}
